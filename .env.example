# Postgres connection string (e.g. from Vercel Postgres / Neon)
DATABASE_URL=

# Random secret used to sign NextAuth session tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Resend API key, used to send password reset emails. https://resend.com/api-keys
RESEND_API_KEY=

# "From" address for transactional emails. Use a verified domain in production;
# onboarding@resend.dev works for testing without domain verification.
EMAIL_FROM="Ascend Aegis <onboarding@resend.dev>"
